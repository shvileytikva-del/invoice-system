# העתיקו קובץ זה ל- .env.local ומלאו את הערכים מתוך Supabase Dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# מפתח ה-service role (סודי! לא לחשוף ב-frontend) - נדרש רק בשרת (API routes) לצורך
# פעולות שדורשות הרשאה מלאה, כמו כתיבה ל-activity_log
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
